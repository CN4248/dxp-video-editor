# 应用版本（与 VERSION 文件、镜像 tag 保持一致）
APP_VERSION=1.3.2
# 宿主机素材 / 成片目录（挂载到容器内的 /input、/output）
HOST_INPUT_DIR=./input
HOST_OUTPUT_DIR=./output
# 对外端口
WEB_PORT=3873
# 基础镜像（国内网络可改为镜像站，例如 docker.m.daocloud.io/library/python:3.12-alpine3.21）
BASE_IMAGE=python:3.12-alpine3.21
# Alpine apk 镜像站，例如 mirrors.aliyun.com（留空则使用官方源）
APK_MIRROR=
# 可选访问口令（用户名固定为 cinecut）
ACCESS_PASSWORD=
